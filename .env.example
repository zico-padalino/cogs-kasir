APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8900

# Cloudflare Tunnel (akses publik sementara):
#   Quick:  powershell -ExecutionPolicy Bypass -File scripts/start-cloudflare-tunnel.ps1
#   Named:  setup scripts/setup-cloudflare-tunnel.ps1 lalu start dengan -Mode Named
# Quick tunnel otomatis memperbarui APP_URL ke https://....trycloudflare.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cogs_perhitungan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Shared hosting: file lebih ringan (kurangi EP/NPROC). Jangan pakai database cache tanpa tabel.
CACHE_STORE=file
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cache katalog menu QR/kasir (detik). Invalidate otomatis saat menu diubah.
POS_MENU_CACHE_TTL=180

# Poll berkala (detik) — hanya dipakai jika KASIR/DAPUR_POLL_ENABLED=true.
# Default: poll OFF; pull sekali saat push (ada pesanan) agar EP/NPROC tidak penuh.
POS_POLL_INTERVAL=60
POS_AUTO_LOAD_ORDER=true

# Poll interval terus-menerus. false = ambil data saat push / buka layar / refresh manual.
# API pending & dapur tetap mengembalikan data nyata untuk pull on-demand.
KASIR_POLL_ENABLED=false
DAPUR_POLL_ENABLED=false

# Kategori stasiun (slug menu_category). Default di config/pos.php:
# dapur = makanan,snack | bar = minuman
# POS_KITCHEN_CATEGORIES=makanan,snack
# POS_BAR_CATEGORIES=minuman

# Kasir push (app/browser tertutup). Mobile = Expo (otomatis). Web = jalankan:
#   php artisan kasir:vapid-keys
KASIR_PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM=
VAPID_SUBJECT=mailto:admin@kedaitjoan.online
# APK push (FCM langsung). Atau letakkan file di storage/app/firebase/service-account.json
FIREBASE_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=
